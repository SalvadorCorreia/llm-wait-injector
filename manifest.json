{
  "manifest_version": 3,
  "name": "llm-wait-injector",
  "version": "1.0.0",
  "description": "Injects content into LLM interfaces while waiting for a response.",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*", "*://claude.ai/*"],
      "css": ["payload/style.css"],
      "js": [
        "src/registry.js",
        "src/providers/chatgpt.js",
        "src/providers/claude.js",
        "src/injector.js",
        "payload/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
