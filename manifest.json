{
  "manifest_version": 3,
  "name": "llm-wait-injector",
  "version": "1.0.0",
  "description": "Injects content into LLM interfaces while waiting for a response.",
  "icons": {
    "16": "icons/base_icon.png",
    "48": "icons/base_icon.png",
    "128": "icons/base_icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://notebook.google.com/notebook/*",
        "*://www.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://aistudio.google.com/*"
      ],
      "css": ["payload/style.css"],
      "js": [
        "src/registry.js",
        "src/providers/chatgpt.js",
        "src/providers/claude.js",
        "src/providers/gemini.js",
        "src/providers/gemininotebook.js",
        "src/providers/perplexity.js",
        "src/providers/deepseek.js",
        "src/providers/googleaistudio.js",
        "src/injector.js",
        "payload/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
